---
import { Image } from "astro:assets";
import Outro from "./Outro.astro";
---

<footer class="text-xs flex flex-col md:flex-row justify-between text-center">
  <p class="font-hand">Made with 💖 for Coding &amp; Reading</p>
  <!-- <Outro /> -->
  <div>
    <p class="personalBrand mb-0">
      <a href="https://supersiddy.wordpress.com/"
        ><Image
          class="profilePhoto"
          src=`${import.meta.env.BASE_URL}profile-photo-siddhesh.jpg`
          alt="Siddhesh's Profile"
          height="32"
          width="32"
        />Siddhesh Thadeshwar</a
      >
    </p>
    <p class="mb-4 text-xs">
      <span
        class="socialLinks inline-flex gap-4 justify-center ml-4 items-center"
      >
        <a target="_blank" href="https://github.com/djsiddz"
          ><span class="sr-only">Github Profile</span><i
            class="bi bi-github socialIcon"></i></a
        >
        <a target="_blank" href="https://linkedin.com/in/siddheshthadeshwar"
          ><span class="sr-only">LinkedIn</span><i
            class="bi bi-linkedin socialIcon"></i></a
        >
        <a target="_blank" href="https://threads.net/super__siddy"
          ><span class="sr-only">Threads</span><i
            class="bi bi-threads socialIcon"></i></a
        >
        <a target="_blank" href="https://twitter.com/super_siddy"
          ><span class="sr-only">X/Twitter</span><i
            class="bi bi-twitter-x socialIcon"></i></a
        >
      </span>
    </p>
  </div>
</footer>
<style>
  @reference "../styles/global.css";
  .personalBrand {
    @apply flex items-center justify-center;
  }
  .profilePhoto {
    @apply rounded-[16px] mr-3 aspect-square w-4;
  }
  footer a,
  footer a:visited,
  footer a:focus,
  footer a:hover {
    @apply text-(--text);
  }
  .personalBrand > a {
    @apply flex flex-col md:flex-row justify-center items-center;
  }
  .socialLinks a {
    @apply text-(--text) transition-[rotate_0.5s,scale_0.25s];
  }
  .socialLinks a:hover {
    @apply -rotate-15 scale-125;
  }
</style>
